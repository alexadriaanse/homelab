#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OP_IMAGE="1password/op:2"
OP_TOKEN_FILE="$SCRIPT_DIR/.op-token"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [app]

Commands:
  inject  [app]  Inject secrets from 1Password into .env files
  yaml    [app]  Print TrueNAS Custom App YAML snippet
  logs    <app>  Tail logs (app required)
  status         Show status of all apps

If [app] is omitted, the command runs for all discovered apps.
EOF
}

get_all_apps() {
    find "$SCRIPT_DIR/" -maxdepth 2 -name "compose.yml" -exec dirname {} \; | sort
}

resolve_app() {
    local app="$1"
    local dir="$SCRIPT_DIR/$app"
    if [[ ! -f "$dir/compose.yml" ]]; then
        echo "error: no compose.yml found for '$app'" >&2
        exit 1
    fi
    echo "$dir"
}

load_op_token() {
    if [[ -f "$OP_TOKEN_FILE" ]]; then
        OP_SERVICE_ACCOUNT_TOKEN="$(cat "$OP_TOKEN_FILE")"
        export OP_SERVICE_ACCOUNT_TOKEN
    else
        echo "error: token file not found: $OP_TOKEN_FILE" >&2
        exit 1
    fi
}

cmd_inject() {
    local dir="$1"
    if [[ -f "$dir/env.tpl" ]]; then
        echo "  [$(basename "$dir")] injecting secrets..."
        docker run --rm \
            --entrypoint op \
            --user root \
            -e OP_SERVICE_ACCOUNT_TOKEN \
            -v "$dir:/work" \
            "$OP_IMAGE" \
            inject -i /work/env.tpl -o /work/.env
    fi
}

cmd_yaml() {
    local dir="$1"
    cat <<EOF
include:
  - $dir/compose.yml
services: {}
EOF
}

cmd_logs() {
    local dir="$1"
    local args=(-f "$dir/compose.yml")
    [[ -f "$dir/.env" ]] && args+=(--env-file "$dir/.env")
    docker compose "${args[@]}" logs -f
}

cmd_status() {
    while IFS= read -r dir; do
        echo "=== $(basename "$dir") ==="
        local args=(-f "$dir/compose.yml")
        [[ -f "$dir/.env" ]] && args+=(--env-file "$dir/.env")
        docker compose "${args[@]}" ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
        echo
    done < <(get_all_apps)
}

run_for_all_inject() {
    local apps
    mapfile -t apps < <(get_all_apps)
    if [[ ${#apps[@]} -eq 0 ]]; then
        echo "no apps found (no compose.yml in subdirectories)" >&2
        exit 1
    fi
    for dir in "${apps[@]}"; do
        cmd_inject "$dir"
    done
}

# --- main ---

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    inject)
        load_op_token
        if [[ $# -gt 0 ]]; then
            cmd_inject "$(resolve_app "$1")"
        else
            run_for_all_inject
        fi
        ;;
    yaml)
        if [[ $# -gt 0 ]]; then
            cmd_yaml "$(resolve_app "$1")"
        else
            while IFS= read -r dir; do
                echo "# $(basename "$dir")"
                cmd_yaml "$dir"
                echo
            done < <(get_all_apps)
        fi
        ;;
    logs)
        if [[ $# -eq 0 ]]; then
            echo "error: 'logs' requires an app name" >&2
            exit 1
        fi
        cmd_logs "$(resolve_app "$1")"
        ;;
    status)
        cmd_status
        ;;
    *)
        echo "error: unknown command '$COMMAND'" >&2
        echo
        usage
        exit 1
        ;;
esac
